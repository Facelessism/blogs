---
import "../styles/global.css";
import "../styles/admin.css";
import AdminAuthGuard from "../components/admin/AdminAuthGuard.astro";

interface Props {
  title?: string;
}

const { title = "Dashboard" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0d10" />
    <title>{title} | Blog Admin</title>
  </head>
  <body class="admin-app">
    <header class="admin-header">
      <div class="admin-header-inner">
        <a class="admin-logo" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}admin/`}>
          Blog<span>.</span>
          <small>ADMIN</small>
        </a>

        <nav class="admin-nav" aria-label="Admin navigation">
          <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}admin/`}>Dashboard</a>
          <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}admin/new/`}>New article</a>
          <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}`} target="_blank" rel="noreferrer">View blog ↗</a>
        </nav>
      </div>
    </header>

    <main class="admin-container">
      <slot />
      <AdminAuthGuard />
    </main>

    <footer class="admin-footer">
      <div>Content management prototype</div>
      <div>Local browser storage · Not yet connected to GitHub</div>
    </footer>
  </body>
</html>
