---
import BaseLayout from "./BaseLayout.astro";
import { getPostReadingTime, slugify } from "../lib/blog";
import type { BlogPost } from "../lib/blog";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const readingTime = getPostReadingTime(post);
const dateFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric"
});
const formattedDate = dateFormatter.format(post.data.pubDate);
const updatedDate = post.data.updatedDate
  ? dateFormatter.format(post.data.updatedDate)
  : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
>
  <article class="container article">
    <a class="back-link" href="/article/">← All articles</a>
    <header class="article-header">
      <div class="categories">
        {post.data.categories.map((category) => (
          <a href={`/article/category/${slugify(category)}/`}>{category}</a>
        ))}
      </div>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="metadata">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        {updatedDate && <span>Updated {updatedDate}</span>}
        <span>{readingTime.words.toLocaleString()} words</span>
        <span>{readingTime.label}</span>
      </div>
      {post.data.tags.length > 0 && (
        <ul class="tags" aria-label="Article tags">
          {post.data.tags.map((tag) => (
            <li><a href={`/article/tag/${slugify(tag)}/`}>#{tag}</a></li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose article-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 800px;
    padding-top: 48px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .article-header {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .categories,
  .metadata,
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .categories a {
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 650;
  }

  h1 {
    margin: 16px 0;
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    line-height: 1.12;
    letter-spacing: -0.055em;
  }

  .description {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.15rem;
  }

  .metadata {
    margin-top: 22px;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .tags {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .article-content {
    padding-top: 18px;
  }
</style>
