
<section class="admin-toolbar" aria-label="Filter articles">
  <input
    class="admin-field"
    type="search"
    placeholder="Search articles by title or slug..."
    aria-label="Search articles"
    data-post-search
  />
  <select class="admin-select" aria-label="Filter article status" data-post-filter>
    <option value="all">All articles</option>
    <option value="published">Published</option>
    <option value="draft">Drafts</option>
  </select>
</section>

<section class="admin-post-list" aria-label="Articles" data-post-list>
  <div class="admin-empty">
    <p>Loading articles...</p>
  </div>
</section>

<script>
  import {
    deleteRemotePost,
    listRemotePosts,
    type RemotePost,
  } from "../../lib/admin/api";

  interface ParsedPost extends RemotePost {
    title: string;
    description: string;
    pubDate: string;
    draft: boolean;
  }

  const root = document.querySelector<HTMLElement>("[data-post-list]");
  const search = document.querySelector<HTMLInputElement>("[data-post-search]");
  const filter = document.querySelector<HTMLSelectElement>("[data-post-filter]");

  function readFrontmatter(content: string): Record<string, string> {
    const match = content.match(/^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/);

    if (!match) {
      throw new Error("A repository post has invalid Markdown frontmatter.");
    }

    const fields: Record<string, string> = {};

    for (const line of match[1].split(/\r?\n/)) {
      const field = line.match(/^([A-Za-z][A-Za-z0-9]*):\s*(.*)$/);

      if (field) {
        fields[field[1]] = field[2].trim();
      }
    }

    return fields;
  }

  function readString(value: string | undefined, fallback = ""): string {
    if (value === undefined) return fallback;

    try {
      const parsed: unknown = JSON.parse(value);
      return typeof parsed === "string" ? parsed : fallback;
    } catch {
      return value.replace(/^["']|["']$/g, "");
    }
  }

  function parsePost(post: RemotePost): ParsedPost {
    const fields = readFrontmatter(post.content);

    if (!fields.title || !fields.description || !fields.pubDate) {
      throw new Error(`Post "${post.slug}" is missing required frontmatter.`);
    }

    return {
      ...post,
      title: readString(fields.title, post.slug),
      description: readString(fields.description),
      pubDate: readString(fields.pubDate).slice(0, 10),
      draft: fields.draft === "true",
    };
  }

  function showMessage(heading: string, message: string): void {
    if (!root) return;

    const empty = document.createElement("div");
    empty.className = "admin-empty";

    const title = document.createElement("h2");
    title.textContent = heading;

    const detail = document.createElement("p");
    detail.textContent = message;

    empty.append(title, detail);
    root.replaceChildren(empty);
  }

  if (root && search && filter) {
    let posts: ParsedPost[] = [];
    let loading = true;

    function render(): void {
      const query = search!.value.trim().toLowerCase();
      const status = filter!.value;

      const filteredPosts = posts.filter((post) => {
        const matchesQuery =
          post.title.toLowerCase().includes(query) ||
          post.slug.toLowerCase().includes(query) ||
          post.description.toLowerCase().includes(query);

        const matchesStatus =
          status === "all" ||
          (status === "draft" && post.draft) ||
          (status === "published" && !post.draft);

        return matchesQuery && matchesStatus;
      });

      root!.replaceChildren();

      if (loading) {
        showMessage("Loading articles", "Fetching posts from GitHub...");
        return;
      }

      if (filteredPosts.length === 0) {
        const heading = query || status !== "all"
          ? "No matching articles"
          : "Your article list is empty";

        const message = query || status !== "all"
          ? "Try changing the search or status filter."
          : "Create your first article to start building your archive.";

        showMessage(heading, message);

        if (!query && status === "all") {
          const link = document.createElement("a");
          link.className = "admin-button admin-button-primary";
          link.href = "/admin/new/";
          link.textContent = "Create article";
          root!.querySelector(".admin-empty")?.append(link);
        }

        return;
      }

      for (const post of filteredPosts) {
        const row = document.createElement("article");
        row.className = "admin-post-row";

        const main = document.createElement("div");
        main.className = "admin-post-main";

        const title = document.createElement("a");
        title.className = "admin-post-title";
        title.href = `/admin/edit/?slug=${encodeURIComponent(post.slug)}`;
        title.textContent = post.title;

        const description = document.createElement("p");
        description.className = "admin-post-description";
        description.textContent = post.description;

        const meta = document.createElement("div");
        meta.className = "admin-post-meta";

        const badge = document.createElement("span");
        badge.className = `admin-status ${
          post.draft ? "admin-status-draft" : "admin-status-published"
        }`;
        badge.textContent = post.draft ? "Draft" : "Published";

        const date = document.createElement("span");
        date.textContent = `Publication date: ${post.pubDate}`;

        const slug = document.createElement("span");
        slug.textContent = `/${post.slug}/`;

        meta.append(badge, date, slug);
        main.append(title, description, meta);

        const actions = document.createElement("div");
        actions.className = "admin-post-actions";

        const edit = document.createElement("a");
        edit.className = "admin-button";
        edit.href = `/admin/edit/?slug=${encodeURIComponent(post.slug)}`;
        edit.textContent = "Edit";

        const remove = document.createElement("button");
        remove.className = "admin-button admin-button-danger";
        remove.type = "button";
        remove.textContent = "Delete";

        remove.addEventListener("click", async () => {
          const confirmed = window.confirm(
            `Delete "${post.title}" from the GitHub repository? This creates a repository change and cannot be undone from this admin interface.`,
          );

          if (!confirmed) return;

          remove.disabled = true;
          remove.textContent = "Deleting...";

          try {
            await deleteRemotePost(post.slug, post.sha);
            posts = posts.filter((item) => item.slug !== post.slug);
            render();
          } catch (error) {
            window.alert(
              error instanceof Error
                ? error.message
                : "Could not delete the article.",
            );
            remove.disabled = false;
            remove.textContent = "Delete";
          }
        });

        actions.append(edit, remove);
        row.append(main, actions);
        root!.append(row);
      }
    }

    async function loadPosts(): Promise<void> {
      loading = true;
      render();

      try {
        const remotePosts = await listRemotePosts();
        posts = remotePosts.map(parsePost);
        loading = false;
        render();
      } catch (error) {
        loading = false;

        showMessage(
          "Could not load articles",
          error instanceof Error
            ? error.message
            : "The GitHub-backed post list could not be loaded.",
        );

        const retry = document.createElement("button");
        retry.type = "button";
        retry.className = "admin-button";
        retry.textContent = "Retry";
        retry.addEventListener("click", () => void loadPosts());
        root!.querySelector(".admin-empty")?.append(retry);
      }
    }

    search.addEventListener("input", render);
    filter.addEventListener("change", render);

    void loadPosts();
  }
</script>
