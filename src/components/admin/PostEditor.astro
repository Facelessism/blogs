
---
interface Props {
  mode: "create" | "edit";
}

const { mode } = Astro.props;
const editing = mode === "edit";
---

<section class="admin-editor-heading">
  <p class="admin-eyebrow">{editing ? "EDIT ARTICLE" : "NEW ARTICLE"}</p>
  <h1>{editing ? "Edit article" : "Create an article"}</h1>
  <p class="admin-subtitle">
    Write in Markdown. Metadata will be validated before saving to GitHub.
  </p>
</section>

<div class="admin-message" role="status" aria-live="polite" data-editor-message>
  {editing ? "Loading article..." : "New articles will be saved to GitHub."}
</div>

<form class="admin-editor" data-admin-editor data-mode={mode} novalidate>
  <div class="admin-form-grid">
    <div class="admin-form-field admin-field-full">
      <label for="post-title">Title</label>
      <input
        class="admin-field"
        id="post-title"
        name="title"
        maxlength="180"
        required
        placeholder="A clear, descriptive title"
      />
    </div>

    <div class="admin-form-field admin-field-full">
      <label for="post-slug">Slug</label>
      <input
        class="admin-field"
        id="post-slug"
        name="slug"
        maxlength="180"
        required
        pattern="[a-z0-9]+(-[a-z0-9]+)*"
        placeholder="generated-from-title"
      />
      <p class="admin-help">
        Used as the article URL. The slug cannot be changed while editing an
        existing article.
      </p>
    </div>

    <div class="admin-form-field admin-field-full">
      <label for="post-description">Description</label>
      <textarea
        class="admin-textarea"
        id="post-description"
        name="description"
        rows="3"
        maxlength="300"
        required
        placeholder="Summarize the article in a few sentences."
      ></textarea>
    </div>

    <div class="admin-form-field">
      <label for="post-date">Publication date</label>
      <input class="admin-field" id="post-date" name="pubDate" type="date" required />
    </div>

    <div class="admin-form-field">
      <label for="post-categories">Categories</label>
      <input class="admin-field" id="post-categories" name="categories" placeholder="Engineering, Notes" />
      <p class="admin-help">Separate multiple categories with commas.</p>
    </div>

    <div class="admin-form-field admin-field-full">
      <label for="post-tags">Tags</label>
      <input class="admin-field" id="post-tags" name="tags" placeholder="typescript, architecture, tooling" />
      <p class="admin-help">Separate multiple tags with commas.</p>
    </div>

    <div class="admin-form-field admin-field-full">
      <label for="post-body">Article content (Markdown)</label>
      <textarea
        class="admin-textarea admin-markdown-field"
        id="post-body"
        name="body"
        required
        spellcheck="false"
        placeholder="# Introduction&#10;&#10;Write your article here..."
      ></textarea>
      <p class="admin-help">
        Use Markdown headings, lists, links, blockquotes, and fenced code blocks.
      </p>
    </div>
  </div>

  <div class="admin-checkbox-row">
    <input id="post-draft" name="draft" type="checkbox" checked />
    <div class="admin-checkbox-copy">
      <label for="post-draft">Keep as draft</label>
      <p>
        Draft articles are stored in GitHub but excluded from the public blog.
      </p>
    </div>
  </div>

  <div class="admin-message admin-message-error" hidden data-editor-errors></div>

  <div class="admin-form-actions">
    <button class="admin-button admin-button-primary" type="submit" data-save-button>
      {editing ? "Save changes" : "Save article"}
    </button>

    <button class="admin-button" type="button" data-export-button>
      Export Markdown
    </button>

    <a class="admin-button" href="/admin/">Cancel</a>
  </div>
</form>

<script>
  import {
    normalizeSlug,
    parseLabels,
    validatePostInput,
    type AdminPost,
    type PostInput,
  } from "../../lib/admin/post-schema";
  import {
    createRemotePost,
    deleteRemotePost,
    listRemotePosts,
    updateRemotePost,
    type RemotePost,
  } from "../../lib/admin/api";
  import { serializeMarkdown } from "../../lib/admin/markdown";

  const form = document.querySelector<HTMLFormElement>("[data-admin-editor]");

  if (form) {
    const mode = form.dataset.mode === "edit" ? "edit" : "create";
    const message = document.querySelector<HTMLElement>("[data-editor-message]");
    const errorsBox = document.querySelector<HTMLElement>("[data-editor-errors]");
    const saveButton = form.querySelector<HTMLButtonElement>("[data-save-button]");
    const exportButton = form.querySelector<HTMLButtonElement>("[data-export-button]");

    const field = <T extends HTMLElement>(name: string) =>
      form.elements.namedItem(name) as T;

    const title = field<HTMLInputElement>("title");
    const slug = field<HTMLInputElement>("slug");
    const description = field<HTMLTextAreaElement>("description");
    const pubDate = field<HTMLInputElement>("pubDate");
    const categories = field<HTMLInputElement>("categories");
    const tags = field<HTMLInputElement>("tags");
    const body = field<HTMLTextAreaElement>("body");
    const draft = field<HTMLInputElement>("draft");

    let previousSlug: string | undefined;
    let originalPost: RemotePost | undefined;
    let lastSaved: AdminPost | undefined;
    let busy = false;

    function localDate(): string {
      const now = new Date();
      const offset = now.getTimezoneOffset() * 60_000;
      return new Date(now.getTime() - offset).toISOString().slice(0, 10);
    }

    function showMessage(
      text: string,
      kind: "error" | "success" | "normal" = "normal",
    ): void {
      if (!message) return;

      message.textContent = text;
      message.className = "admin-message";

      if (kind === "error") message.classList.add("admin-message-error");
      if (kind === "success") message.classList.add("admin-message-success");
    }

    function showErrors(errors: string[]): void {
      if (!errorsBox) return;

      errorsBox.replaceChildren();
      errorsBox.hidden = errors.length === 0;

      if (errors.length === 0) return;

      const heading = document.createElement("strong");
      heading.textContent = "Please fix the following:";

      const list = document.createElement("ul");
      list.className = "admin-error-list";

      for (const error of errors) {
        const item = document.createElement("li");
        item.textContent = error;
        list.append(item);
      }

      errorsBox.append(heading, list);
    }

    function currentInput(): PostInput {
      return {
        title: title.value.trim(),
        slug: normalizeSlug(slug.value),
        description: description.value.trim(),
        body: body.value,
        pubDate: pubDate.value,
        categories: parseLabels(categories.value),
        tags: parseLabels(tags.value),
        draft: draft.checked,
      };
    }

    function parseFrontmatter(content: string): {
      fields: Record<string, string>;
      body: string;
    } {
      const match = content.match(/^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/);

      if (!match) {
        throw new Error("The repository post has invalid Markdown frontmatter.");
      }

      const fields: Record<string, string> = {};

      for (const line of match[1].split(/\r?\n/)) {
        const fieldMatch = line.match(/^([A-Za-z][A-Za-z0-9]*):\s*(.*)$/);

        if (fieldMatch) {
          fields[fieldMatch[1]] = fieldMatch[2].trim();
        }
      }

      return {
        fields,
        body: content.slice(match[0].length).trimStart(),
      };
    }

    function parseString(value: string | undefined, fallback = ""): string {
      if (value === undefined) return fallback;

      try {
        const parsed: unknown = JSON.parse(value);
        return typeof parsed === "string" ? parsed : fallback;
      } catch {
        return value.replace(/^["']|["']$/g, "");
      }
    }

    function parseStringArray(value: string | undefined): string[] {
      if (!value) return [];

      try {
        const parsed: unknown = JSON.parse(value);

        if (Array.isArray(parsed)) {
          return parsed.filter(
            (item): item is string => typeof item === "string",
          );
        }
      } catch {
        // Older frontmatter may use a different array representation.
      }

      return [];
    }

    function parseRemotePost(post: RemotePost): AdminPost {
      const { fields, body: markdownBody } = parseFrontmatter(post.content);

      const parsedTitle = parseString(fields.title);
      const parsedDescription = parseString(fields.description);
      const parsedDate = parseString(fields.pubDate);

      if (!parsedTitle || !parsedDescription || !/^\d{4}-\d{2}-\d{2}$/.test(parsedDate)) {
        throw new Error(`Post "${post.slug}" has invalid required metadata.`);
      }

      const now = new Date().toISOString();
      const updatedDate = parseString(fields.updatedDate);

      return {
        title: parsedTitle,
        slug: post.slug,
        description: parsedDescription,
        body: markdownBody,
        pubDate: parsedDate,
        categories: parseStringArray(fields.categories),
        tags: parseStringArray(fields.tags),
        draft: fields.draft === "true",
        createdAt: now,
        updatedAt: now,
        ...(updatedDate ? { updatedDate } : {}),
      };
    }

    function setBusy(value: boolean): void {
      busy = value;

      if (saveButton) {
        saveButton.disabled = value;
        saveButton.textContent = value
          ? "Saving..."
          : mode === "edit"
            ? "Save changes"
            : "Save article";
      }

      if (exportButton) exportButton.disabled = value;
    }

    function disableEditor(): void {
      form!.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>(
        "input, textarea, button",
      ).forEach((element) => {
        element.disabled = true;
      });

      if (exportButton) exportButton.disabled = true;
    }

    function fillEditor(post: AdminPost): void {
      title.value = post.title;
      slug.value = post.slug;
      slug.readOnly = true;
      description.value = post.description;
      body.value = post.body;
      pubDate.value = post.pubDate;
      categories.value = post.categories.join(", ");
      tags.value = post.tags.join(", ");
      draft.checked = post.draft;
      lastSaved = post;
    }

    function buildMarkdown(input: PostInput): string {
      const now = new Date().toISOString();

      const record: AdminPost = {
        ...input,
        createdAt: lastSaved?.createdAt ?? now,
        updatedAt: now,
        ...(mode === "edit"
          ? { updatedDate: localDate() }
          : {}),
      };

      return serializeMarkdown(record);
    }

    async function loadEditor(): Promise<void> {
      pubDate.value = localDate();

      if (mode !== "edit") {
        showMessage("New article will be saved to GitHub.");
        return;
      }

      const requestedSlug = new URLSearchParams(window.location.search).get("slug");

      if (!requestedSlug) {
        showMessage("No article slug was provided.", "error");
        disableEditor();
        return;
      }

      setBusy(true);

      try {
        const posts = await listRemotePosts();
        const existing = posts.find((post) => post.slug === requestedSlug);

        if (!existing) {
          showMessage(
            "Article not found in the GitHub repository. It may have been deleted.",
            "error",
          );
          disableEditor();
          return;
        }

        originalPost = existing;
        previousSlug = existing.slug;

        const parsed = parseRemotePost(existing);
        fillEditor(parsed);

        showMessage("Article loaded from GitHub.");
      } catch (error) {
        showMessage(
          error instanceof Error
            ? error.message
            : "Could not load the article from GitHub.",
          "error",
        );
        disableEditor();
      } finally {
        setBusy(false);
      }
    }

    title.addEventListener("input", () => {
      if (mode === "create" && !slug.matches(":focus")) {
        slug.value = normalizeSlug(title.value);
      }
    });

    slug.addEventListener("input", () => {
      if (mode === "edit" && previousSlug) {
        slug.value = previousSlug;
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (busy) return;

      const input = currentInput();
      const errors = validatePostInput(input);

      if (mode === "edit" && previousSlug && input.slug !== previousSlug) {
        errors.push("Changing an existing article's slug is not supported.");
      }

      showErrors(errors);

      if (errors.length) {
        showMessage("Article was not saved. Fix the validation errors.", "error");
        return;
      }

      setBusy(true);

      try {
        const posts = await listRemotePosts();

        if (
          posts.some(
            (post) =>
              post.slug === input.slug &&
              post.slug !== previousSlug,
          )
        ) {
          throw new Error("That slug is already used by another article.");
        }

        const markdown = buildMarkdown(input);

        if (mode === "edit") {
          if (!previousSlug || !originalPost) {
            throw new Error("The original GitHub post could not be identified.");
          }

          await updateRemotePost(
            previousSlug,
            markdown,
            originalPost.sha,
          );
        } else {
          await createRemotePost(input.slug, markdown);
        }

        showMessage("Saved to GitHub successfully.", "success");
        window.location.href = "/admin/?saved=1";
      } catch (error) {
        showMessage(
          error instanceof Error
            ? error.message
            : "Could not save the article to GitHub.",
          "error",
        );
      } finally {
        setBusy(false);
      }
    });

    exportButton?.addEventListener("click", () => {
      const input = currentInput();
      const errors = validatePostInput(input);
      showErrors(errors);

      if (errors.length) {
        showMessage("Fix validation errors before exporting.", "error");
        return;
      }

      try {
        const markdown = buildMarkdown(input);
        const blob = new Blob(
          [markdown],
          { type: "text/markdown;charset=utf-8" },
        );

        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = url;
        link.download = `${input.slug || "article"}.md`;
        document.body.append(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);

        showMessage("Markdown file exported.", "success");
      } catch (error) {
        showMessage(
          error instanceof Error
            ? error.message
            : "Could not export Markdown.",
          "error",
        );
      }
    });

    void loadEditor();
  }
</script>
