---
import { slugify } from "../lib/blog";

interface Props {
  categories?: string[];
  tags?: string[];
}

const { categories = [], tags = [] } = Astro.props;
---

<div class="blog-search" data-blog-search>
  <label for="blog-query">Search articles on this page</label>
  <input
    id="blog-query"
    type="search"
    placeholder="Search titles, topics, and tags..."
    autocomplete="off"
  />

  <div class="filters">
    <div class="filter">
      <label for="category-filter">Category</label>
      <select id="category-filter">
        <option value="">All categories</option>
        {categories.map((category) => (
          <option value={slugify(category)}>{category}</option>
        ))}
      </select>
    </div>

    <div class="filter">
      <label for="tag-filter">Tag</label>
      <select id="tag-filter">
        <option value="">All tags</option>
        {tags.map((tag) => (
          <option value={slugify(tag)}>{tag}</option>
        ))}
      </select>
    </div>
  </div>

  <p data-search-status aria-live="polite"></p>
</div>

<script>
  const searchRoot = document.querySelector<HTMLElement>("[data-blog-search]");

  if (searchRoot) {
    const queryInput =
      searchRoot.querySelector<HTMLInputElement>("#blog-query");
    const categoryFilter =
      searchRoot.querySelector<HTMLSelectElement>("#category-filter");
    const tagFilter =
      searchRoot.querySelector<HTMLSelectElement>("#tag-filter");
    const status =
      searchRoot.querySelector<HTMLElement>("[data-search-status]");

    const results = document.querySelector<HTMLElement>("[data-blog-results]");
    const pagination =
      document.querySelector<HTMLElement>("[data-blog-pagination]");
    const noResults =
      results?.querySelector<HTMLElement>("[data-no-results]");

    function filterPosts() {
      const query = queryInput?.value.trim().toLowerCase() ?? "";
      const category = categoryFilter?.value ?? "";
      const tag = tagFilter?.value ?? "";
      const filtering = Boolean(query || category || tag);
      const cards =
        results?.querySelectorAll<HTMLElement>(".blog-card") ?? [];
      let visible = 0;

      cards.forEach((card) => {
        const title = card.dataset.title ?? "";
        const description = card.dataset.description ?? "";
        const categories = (card.dataset.categories ?? "")
          .split("|")
          .filter(Boolean);
        const tags = (card.dataset.tags ?? "")
          .split("|")
          .filter(Boolean);

        const searchableText = [
          title,
          description,
          ...categories,
          ...tags,
        ]
          .join(" ")
          .replaceAll("-", " ");

        const matchesQuery = !query || searchableText.includes(query);
        const matchesCategory = !category || categories.includes(category);
        const matchesTag = !tag || tags.includes(tag);
        const show =
          matchesQuery && matchesCategory && matchesTag;

        card.hidden = !show;

        if (show) visible++;
      });

      if (noResults) {
        noResults.hidden = !filtering || visible > 0;
      }

      if (pagination) {
        pagination.hidden = filtering;
      }

      if (status) {
        if (filtering) {
          status.textContent =
            `${visible} matching article${visible === 1 ? "" : "s"} on this page. Clear filters to restore pagination.`;
        } else {
          status.textContent =
            `${cards.length} article${cards.length === 1 ? "" : "s"} on this page.`;
        }
      }
    }

    queryInput?.addEventListener("input", filterPosts);
    categoryFilter?.addEventListener("change", filterPosts);
    tagFilter?.addEventListener("change", filterPosts);

    filterPosts();
  }
</script>

<style>
  .blog-search {
    display: grid;
    gap: 10px;
    margin-bottom: 24px;
  }

  .blog-search label {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .blog-search input,
  .blog-search select {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 0.9rem;
  }

  .blog-search input::placeholder {
    color: var(--color-muted);
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
  }

  .filter {
    display: grid;
    gap: 6px;
  }

  [data-search-status] {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.82rem;
  }
</style>
