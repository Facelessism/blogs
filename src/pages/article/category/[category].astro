---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import {
  getPublishedPosts,
  getCategoryItems,
} from "../../../lib/blog";

export async function getStaticPaths() {
  const [posts, categories] = await Promise.all([
    getPublishedPosts(),
    getCategoryItems(),
  ]);

  return categories.map(({ label, slug }) => ({
    params: { category: slug },
    props: {
      category: label,
      posts: posts.filter((post) =>
        post.data.categories.includes(label),
      ),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={`Category: ${category}`}
  description={`Published articles in the ${category} category.`}
>
  <section class="container archive">
    <a class="back-link" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}article/`}>← All articles</a>
    <p class="eyebrow">CATEGORY</p>
    <h1>{category}</h1>

    <div class="post-list">
      {posts.length > 0 ? (
        posts.map((post) => <BlogCard post={post} />)
      ) : (
        <p class="empty">No published articles in this category yet.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    max-width: 850px;
    padding-top: 64px;
  }

  .back-link {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .eyebrow {
    margin-top: 40px;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 10px 0 28px;
    font-size: clamp(2.5rem, 7vw, 4rem);
    letter-spacing: -0.055em;
  }

  .empty {
    color: var(--color-muted);
  }
</style>
