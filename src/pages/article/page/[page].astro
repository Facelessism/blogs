---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import BlogSearch from "../../../components/BlogSearch.astro";
import Pagination from "../../../components/Pagination.astro";
import { getPublishedPosts, getCategories, getTags } from "../../../lib/blog";

const pageSize = 10;

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / pageSize);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;

    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * pageSize, page * pageSize),
        currentPage: page,
        totalPages
      }
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
const [categories, tags] = await Promise.all([
  getCategories(),
  getTags()
]);
---

<BaseLayout title={`Articles · Page ${currentPage}`} description={`Published articles, page ${currentPage}.`}>
  <section class="container listing">
    <header class="listing-header">
      <p class="eyebrow">THE ARCHIVE</p>
      <h1>Articles</h1>
      <p>Page {currentPage} of {totalPages}</p>
    </header>
    <BlogSearch categories={categories} tags={tags} />
    <div class="post-list" data-blog-results>
      {posts.map((post) => <BlogCard post={post} />)}
      <p class="no-results" data-no-results hidden>No articles match your filters.</p>
    </div>
    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </section>
</BaseLayout>

<style>
  .listing {
    max-width: 850px;
    padding-top: 64px;
  }

  .listing-header {
    padding-bottom: 24px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 12px 0;
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
  }

  .listing-header > p:last-child {
    color: var(--color-muted);
  }

  .no-results {
    padding: 24px 0;
    color: var(--color-muted);
  }
</style>
