---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import {
  getPublishedPosts,
  getTagItems,
} from "../../../lib/blog";

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([
    getPublishedPosts(),
    getTagItems(),
  ]);

  return tags.map(({ label, slug }) => ({
    params: { tag: slug },
    props: {
      tag: label,
      posts: posts.filter((post) =>
        post.data.tags.includes(label),
      ),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`Tag: ${tag}`}
  description={`Published articles tagged ${tag}.`}
>
  <section class="container archive">
    <a class="back-link" href="/article/">← All articles</a>
    <p class="eyebrow">TAG</p>
    <h1>#{tag}</h1>

    <div class="post-list">
      {posts.length > 0 ? (
        posts.map((post) => <BlogCard post={post} />)
      ) : (
        <p class="empty">No published articles with this tag yet.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    max-width: 850px;
    padding-top: 64px;
  }

  .back-link {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .eyebrow {
    margin-top: 40px;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 10px 0 28px;
    font-size: clamp(2.5rem, 7vw, 4rem);
    letter-spacing: -0.055em;
  }

  .empty {
    color: var(--color-muted);
  }
</style>
