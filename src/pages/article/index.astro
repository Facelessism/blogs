---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import BlogSearch from "../../components/BlogSearch.astro";
import Pagination from "../../components/Pagination.astro";
import { getPublishedPosts, getCategories, getTags } from "../../lib/blog";

const pageSize = 10;
const posts = await getPublishedPosts();
const pagePosts = posts.slice(0, pageSize);
const totalPages = Math.ceil(posts.length / pageSize);
const [categories, tags] = await Promise.all([
  getCategories(),
  getTags()
]);
---

<BaseLayout title="Articles" description="Browse all published articles.">
  <section class="container listing">
    <header class="listing-header">
      <p class="eyebrow">THE ARCHIVE</p>
      <h1>Articles</h1>
      <p>Explore articles, ideas, and technical notes.</p>
    </header>
    <BlogSearch categories={categories} tags={tags} />
    <div class="post-list" data-blog-results>
      {pagePosts.length > 0 ? (
        pagePosts.map((post) => <BlogCard post={post} />)
      ) : (
        <p class="empty">No published articles yet.</p>
      )}
      <p class="no-results" data-no-results hidden>No articles match your filters.</p>
    </div>
    <Pagination currentPage={1} totalPages={totalPages} />
  </section>
</BaseLayout>

<style>
  .listing {
    max-width: 850px;
    padding-top: 64px;
  }

  .listing-header {
    padding-bottom: 24px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 12px 0;
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
  }

  .listing-header > p:last-child,
  .empty {
    color: var(--color-muted);
  }

  .no-results {
    padding: 24px 0;
    color: var(--color-muted);
  }
</style>
